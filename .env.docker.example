# 默认端口与当前数据目录
JIANGHU_PORT=8000
JIANGHU_DATA_DIR=./.data
JIANGHU_IMAGE_TAG=local

# Matrix/Synapse 可观察协作平面。访问地址默认是 http://localhost:8008。
# Application Service Token、Homeserver Token 和 Synapse 数据库密码由
# Docker 首次启动时生成到独立命名卷，不写入源码或 .env。
MATRIX_SERVER_NAME=localhost
MATRIX_PORT=8008

# 镜像内固定版本
NODE_VERSION=24

# 首次部署也可以留空，启动后在“模型与凭据”页面配置。
# 不要把真实 Token 提交到 Git。
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_DEFAULT_SONNET_MODEL=

# 仅 compose.postgres.yaml 模式使用
POSTGRES_DB=jianghu
POSTGRES_USER=jianghu
POSTGRES_PASSWORD=replace-with-a-long-random-password
