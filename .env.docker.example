# 默认端口与当前数据目录
JIANGHU_PORT=8000
JIANGHU_DATA_DIR=./.data
JIANGHU_IMAGE_TAG=local

# 镜像内固定版本
NODE_VERSION=24
OPENCLAW_VERSION=2026.7.1-2

# 首次部署也可以留空，启动后在“模型与凭据”页面配置。
# 不要把真实 Token 提交到 Git。
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_DEFAULT_SONNET_MODEL=

# 仅 compose.postgres.yaml 模式使用
POSTGRES_DB=jianghu
POSTGRES_USER=jianghu
POSTGRES_PASSWORD=replace-with-a-long-random-password
