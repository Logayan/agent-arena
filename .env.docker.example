# 默认端口与当前数据目录
JIANGHU_PORT=8000
JIANGHU_DATA_DIR=./.data
JIANGHU_IMAGE_TAG=local

# 镜像内固定版本
NODE_VERSION=24
OPENCLAW_VERSION=2026.7.1-2

# 首次部署也可以留空，启动后在“模型与凭据”页面配置。
# 不要把真实 Token 提交到 Git。
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_DEFAULT_SONNET_MODEL=

# 可选的网页登录保护。默认关闭，保持当前内网直连行为。
# 启用后必须同时配置 AUTH_USERS 和 AUTH_SESSION_SECRET；请只写入本机 .env.docker，绝不要提交真实密码。
AUTH_ENABLED=false
# 多账号格式：账号:密码,另一个账号:密码。密码中不要使用英文逗号或冒号。
AUTH_USERS=admin:replace-with-a-strong-password
# 使用至少 32 字符的随机字符串，例如：openssl rand -hex 32
AUTH_SESSION_SECRET=replace-with-a-long-random-session-secret
AUTH_SESSION_TTL_MINUTES=480

# 防爆破：同一“客户端 IP + 账号”在窗口期内连续失败达到上限后，暂时锁定。
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOCKOUT_SECONDS=900
# 只有可信反向代理会正确传递 X-Forwarded-For 时才开启。
AUTH_TRUST_PROXY=false
# HTTPS 反向代理部署时设为 true；当前 HTTP 局域网访问保持 false。
AUTH_COOKIE_SECURE=false

# 仅 compose.postgres.yaml 模式使用
POSTGRES_DB=jianghu
POSTGRES_USER=jianghu
POSTGRES_PASSWORD=replace-with-a-long-random-password
