{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jianghu.example/schemas/runtime-event-envelope.v1.json",
  "title": "Jianghu Runtime Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "run_id",
    "sequence",
    "type",
    "category",
    "created_at",
    "payload"
  ],
  "properties": {
    "event_id": {"type": "string", "pattern": "^evt_[A-Za-z0-9]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "organization_id": {"type": "string"},
    "sequence": {"type": "integer", "minimum": 1},
    "type": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
    "category": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "projection": {"type": "string"},
    "source_event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {
      "type": "object",
      "properties": {
        "execution_epoch": {"type": "integer", "minimum": 1},
        "platform_attempt_id": {"type": ["string", "null"]},
        "task_id": {"type": ["string", "null"]},
        "node_key": {"type": ["string", "null"]},
        "agent_id": {"type": ["string", "null"]},
        "role_instance_id": {"type": ["string", "null"]},
        "platform_session_id": {"type": ["string", "null"]},
        "claude_sdk_session_id": {"type": ["string", "null"]},
        "sdk_invocation_id": {"type": ["string", "null"]},
        "tool_call_id": {"type": ["string", "null"]},
        "operation_id": {"type": ["string", "null"]},
        "idempotency_key": {"type": ["string", "null"]},
        "request_sha256": {"type": ["string", "null"], "pattern": "^$|^[0-9a-f]{64}$"},
        "result_sha256": {"type": ["string", "null"], "pattern": "^$|^[0-9a-f]{64}$"},
        "artifact_id": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^$|^[0-9a-f]{64}$"},
        "causation_event_id": {"type": ["string", "null"]},
        "supersedes_event_id": {"type": ["string", "null"]},
        "status": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    }
  }
}
