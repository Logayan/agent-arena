{
  "name": "agent-arena",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,client -c blue,green \"npm run dev:api\" \"npm run dev:client\"",
    "dev:api": "python -m uvicorn server.app.main:app --reload --port 8003",
    "dev:client": "npm --prefix client run dev",
    "test": "npm run test:api && npm run build:client",
    "test:api": ".venv\\Scripts\\python.exe -m pytest server/tests",
    "build:client": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
